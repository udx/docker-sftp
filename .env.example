# Canonical local configuration contract for docker-sftp.
# Copy to .env, replace placeholders, and pass it with `docker run --env-file .env`.
# Never commit the populated .env file or credential files.

# Required: GitHub authentication used to discover collaborators and SSH keys.
ACCESS_TOKEN=replace-with-github-token

# Required for manual/out-of-cluster Kubernetes access.
KUBERNETES_CLUSTER_ENDPOINT=https://kubernetes.example.com
KUBERNETES_CLUSTER_NAME=example-cluster
KUBERNETES_CLUSTER_SERVICEACCOUNT=sftp-gateway
KUBERNETES_CLUSTER_USER_TOKEN=replace-with-service-account-token

# Recommended: path to a mounted CA certificate. The setup script otherwise
# uses insecure TLS verification for out-of-cluster endpoints.
# KUBERNETES_CLUSTER_CERTIFICATE=/run/secrets/kubernetes-ca.crt

# Optional server and authorization settings.
NODE_PORT=8080
ALLOW_SSH_ACCESS_ROLES=admin,maintain,write
PRODUCTION_BRANCH=production
ALLOW_SSH_ACCES_PROD_ROLES=admin

# Optional Firebase deployment watcher. Mount the service-account JSON file at
# this path; the watcher stays inactive when either value is absent.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_DATABASE_URL=https://example.firebaseio.com

# Optional Slack notifications. Variable names retain the runtime's historical
# spelling and must match exactly.
# SLACK_NOTIFICACTION_URL=https://hooks.slack.com/services/replace/me
# SLACK_NOTIFICACTION_CHANNEL=operations
